{
  "manifest_version": 3,
  "name": "电商图片提取下载插件",
  "version": "1.0.0",
  "description": "一键提取电商详情页所有商品图片，支持淘宝、京东、拼多多，批量下载为PNG格式",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "host_permissions"
  ],
  "host_permissions": [
    "*://*.taobao.com/*",
    "*://*.tmall.com/*",
    "*://*.jd.com/*",
    "*://*.pinduoduo.com/*",
    "*://*.yangkeduo.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.taobao.com/*",
        "*://*.tmall.com/*",
        "*://*.jd.com/*",
        "*://*.pinduoduo.com/*",
        "*://*.yangkeduo.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "gallery.html"
  }
}
